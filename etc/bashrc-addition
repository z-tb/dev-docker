#------------------------------------------------------------------
# if in a docker container, or DinD, return the whale icon, otherwise whatever was passed
#------------------------------------------------------------------
is_docker()
{
    sys_sep="$1"
    if [ -f /.dockerenv ]; then
      sys_sep='[🐳]'
    fi  

    # host docker socket mounted: overrides the plain whale
    if [ -S /var/run/docker.sock ]; then
        sys_sep='[🐳🔌]'
    fi  

    echo $sys_sep
}


#------------------------------------------------------------------
# color prompt - run pcol from ~/.bashrc to activate
#------------------------------------------------------------------
function pcol() {
    # Determine prompt character
    if [ "$(id -u)" -eq 0 ]; then
        PCHAR='#'
    else
        PCHAR='$'
    fi

    # Define color codes (all with black background)
         BOLD_BLUE='\[\e[1;34;40m\]'  # Bright Blue
         BOLD_CYAN='\[\e[1;36;40m\]'  # Cyan / Ice Blue
       BOLD_YELLOW='\[\e[1;33;40m\]'  # Yellow (for Date)
      BOLD_MAGENTA='\[\e[1;35;40m\]'  # Magenta (for Path)
        LIGHT_BLUE='\[\e[1;94;40m\]'  # Light High-Intensity Blue
             WHITE='\[\e[1;37;40m\]'  # Bright White
             RESET='\[\e[0m\]'

    # Build prompt components
    TIME_DATE="[${BOLD_BLUE}\$(date '+%I:%M')${RESET} \$(is_docker) ${BOLD_YELLOW}\$(date '+%D')${RESET}\$(display_git_branch)${BOLD_CYAN}]${RESET}"
    USER_HOST="[${BOLD_CYAN}\u${WHITE}@${LIGHT_BLUE}\h ${BOLD_MAGENTA}\w${BOLD_CYAN}]${RESET}"
    PCHAR="${BOLD_CYAN}${PCHAR}${RESET}"

    # Combine into multi-line PS1
    PS1="${TIME_DATE}\n${USER_HOST}\n${PCHAR} "
    export PS1
}

