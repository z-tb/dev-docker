
#------------------------------------------------------------------
# returns 1 if branch modified
#------------------------------------------------------------------
is_branch_modified()
{
   status=0
   test -n "`git diff 2>/dev/null`" && status=1
   echo $status
}

#------------------------------------------------------------------
# for use with gpull and other aliasse
#------------------------------------------------------------------
get_git_branch()
{
    git branch 2> /dev/null | grep '^*' |  sed -e '#^[^*]#d' -e 's#[*\(\) ]##g'
}

#------------------------------------------------------------------
# display git branch in prompt if cwd is a repo. color change if
# modifications present
#------------------------------------------------------------------
display_git_branch () 
{ 
    bcolor="\033[0;30;42m";
    test $(is_branch_modified) -eq 1 && bcolor="\033[1;33;41m";
    b="`git branch 2> /dev/null | grep '^*' |  sed -e '#^[^*]#d' -e 's#[*\(\) ]##g'`";
    notes_present=$(git notes list 2> /dev/null | wc -l);
    note_indicator="";
    if [ "$notes_present" -gt 0 ]; then
        note_indicator="📜";
    fi;
    test ! -z "$b" && echo -e "\033[1;0;40m $bcolor⎇ " "$note_indicator$b\033[0;00;0m"
}



#------------------------------------------------------------------
# show git notes for repo
#------------------------------------------------------------------
git_show_notes_all () 
{ 
    CYAN="\033[1;36m";
    YELLOW="\033[1;33m";
    SILVER="\033[38;5;234m";
    RESET="\033[0m";
    git notes list | while read note commit; do
        commit_date=$(git show -s --format=%cr $commit);
        commit_author=$(git show -s --format='%an <%ae>' $commit);
        commit_title=$(git show -s --format=%s $commit);
        branches=$(git branch --contains $commit | sed 's/^[* ]*//;s/$/, /' | tr -d '\n' | sed 's/, $//');
        echo -e "${YELLOW}Commit :${CYAN}$commit${RESET}";
        echo -e "${YELLOW}Date   :${SILVER}$commit_date${RESET}";
        echo -e "${YELLOW}Author :${SILVER}$commit_author${RESET}";
        echo -e "${YELLOW}Title  :${SILVER}$commit_title${RESET}";
        echo -e "${YELLOW}Branch :${SILVER}${branches:-<none>} ${RESET}";
        echo -e "${YELLOW}Note:${RESET}";
        git notes show $commit | while IFS= read -r line; do
            echo -e "${SILVER}${line}${RESET}";
        done;
        echo;
    done
}


#------------------------------------------------------------------
# launch ssh-agent, if not running and ssh-add all private keys
#------------------------------------------------------------------
shad() {
    # expected paths for ssh-agent
    local ssh_agent_paths=("/bin/ssh-agent" "/usr/bin/ssh-agent")

    # Check for and start the SSH agent using the absolute paths
    local ssh_agent_found=false
    for path in "${ssh_agent_paths[@]}"; do
        if [ -x "$path" ]; then
            eval "$($path -s)"
            ssh_agent_found=true
            break
        fi
    done

    if [ "$ssh_agent_found" = false ]; then
        echo "No valid ssh-agent found at expected paths."
        return 1
    fi

    local ssh_dir="$HOME/.ssh"

    # Loop through all private key files that do not end in .pub
    for key in "$ssh_dir"/id_*; do
        if [ -f "$key" ] && [[ "$key" != *.pub ]]; then
            ssh-add "$key"
        fi
    done
}

